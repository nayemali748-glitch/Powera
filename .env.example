# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Apps Script Web App URL & Google Sheet ID (Single Source of Truth)
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/AKfycbzVV5sqqypop3sr19hstcti76QXw4aGIKHqAut31pcYMcOuffGwsAmtfbbOnx3KVB_7/exec
GOOGLE_SHEET_ID=1-3LtAbXZU6klisReK6ffIxDUwbM4wXvhxSbKVpE7raY

# 2Factor.in Official SMS OTP Gateway
# TWOFACTOR_API_KEY is REQUIRED for sending SMS OTPs
TWOFACTOR_API_KEY=""
# Optional custom DLT template overrides (leave empty to use 2Factor's official default SMS OTP service):
TWOFACTOR_LOGIN_TEMPLATE=""
TWOFACTOR_FORGOT_TEMPLATE=""

# Dedicated Master Office Registry Google Spreadsheet (Strictly isolated from production database)
OFFICE_REGISTRY_SPREADSHEET_ID=1-mceU8a_JjYTrU3QUFGDKiXGRVA1AvzklKgoc-ezkAw

# Google Cloud Service Account Credentials for Office Registry & Spreadsheet Verification
# Project: gen-lang-client-0685870335
# Option A: Full JSON string of service account key
GOOGLE_SERVICE_ACCOUNT_KEY=""
# Option B: Separate service account email and private key PEM
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

